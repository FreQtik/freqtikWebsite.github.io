    <item>
      <g:id>IMPULSE-ANVIL-WIN-FULL</g:id>
      <g:title>Impulse Anvil – Impulse Response Designer &amp; Convolution VST3 Plugin for Windows</g:title>
      <g:description>Impulse Anvil is a Windows 10/11 64-bit VST3 plugin for designing, morphing, auditioning and exporting custom impulse responses. Load two impulse responses, recordings or found sounds, shape each source, morph their time, spectral and stereo structure, preview the result through convolution, and bake reusable standard WAV impulse responses. The full license includes 126 handmade IRs and two license seats.</g:description>
      <g:link>https://freqtik.com/impulse-anvil.html</g:link>
      <g:image_link>https://freqtik.com/assets/impulse-anvil-plugin-ui.png</g:image_link>
      <g:availability>in_stock</g:availability>
      <g:condition>new</g:condition>
