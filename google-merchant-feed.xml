      <g:adult>no</g:adult>
      <g:product_highlight>Design impulse responses from two IRs, recordings or found sounds.</g:product_highlight>
      <g:product_highlight>Six morph modes plus mode-aware A-to-B Lerp.</g:product_highlight>
      <g:product_highlight>Bake reusable standard WAV impulse responses.</g:product_highlight>
      <g:product_highlight>Includes 126 handmade impulse responses.</g:product_highlight>
      <g:product_highlight>Windows 10/11 64-bit VST3 with two license seats.</g:product_highlight>
